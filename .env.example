# HuggingFace Token (Required)
# Get your token from: https://huggingface.co/settings/tokens
# Request access to: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Whisper Model Directory (Optional)
# Default: ~/.cache/whisper or system default
WHISPER_MODEL_DIR=/path/to/whisper/models

# Default Audio File (Optional)
# You can specify a default audio file to process
AUDIO_FILE=/path/to/your/audio.mp3

# Whisper Model Size (Optional)
# Options: tiny, base, small, medium, large
# Default: small
WHISPER_MODEL_SIZE=small

# Language Code (Optional)
# Examples: en (English), tr (Turkish), de (German), fr (French)
# Leave empty for auto-detection
# Default: en
LANGUAGE=en

# Cache Settings (Optional)
# Enable/disable cache for transcription results
# Default: true
USE_CACHE=true

# Emoji Support (Optional)
# Enable/disable emoji in console output
# Default: true
USE_EMOJI=true
